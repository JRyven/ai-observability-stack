# Copy to .env and adjust for local use.

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me

# Example exporter targets used by documentation and local overrides.
# Prometheus configuration files do not automatically read these values unless
# you template them yourself or update docker-compose/config generation.
NODE_EXPORTER_TARGET=127.0.0.1:9100
GPU_EXPORTER_TARGET=127.0.0.1:9101
LLM_EXPORTER_TARGET=127.0.0.1:9102
OBJECT_STORAGE_EXPORTER_TARGET=127.0.0.1:9000
